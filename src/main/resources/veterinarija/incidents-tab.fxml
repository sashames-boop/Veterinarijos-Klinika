<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.IncidentsController" alignment="CENTER" prefHeight="368.0" prefWidth="720.0" spacing="12">

    <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="720.0" spacing="10.0">
        <children>
            <TextField fx:id="searchField"
                       promptText="Search..." />
            <Button onAction="#openIncidentDelete" text="Delete incident" />
            <Button onAction="#openIncidentEdit" text="Edit incident" />
            <Button onAction="#openIncidentAdd" text="Add new incident" />
        </children>
        <effect>
            <Blend />
        </effect>
        <VBox.margin>
            <Insets />
        </VBox.margin>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
    </HBox>
    <TableView fx:id="incidentsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="incidentIdColumn" prefWidth="45" text="ID" />
            <TableColumn fx:id="incidentCommentColumn" prefWidth="245" text="Comment" />
            <TableColumn fx:id="incidentStatusColumn" prefWidth="100" text="Status" />
            <TableColumn fx:id="incidentCreatedColumn" prefWidth="150" text="Created" />
            <TableColumn fx:id="incidentModifiedColumn" prefWidth="150" text="Modified" />
        </columns>
    </TableView>
</VBox>
