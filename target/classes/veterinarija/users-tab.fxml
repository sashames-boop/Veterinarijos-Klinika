<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UsersController" alignment="CENTER" spacing="12">
    <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="720.0" spacing="10.0">
        <children>
            <TextField fx:id="searchField"
                       promptText="Search..." alignment="CENTER_LEFT" />
            <ToggleButton mnemonicParsing="false" onAction="#toggleUserBlocked" text="Block/Unblock" />
            <ChoiceBox fx:id="userTypeFilter" prefWidth="144.0" />
            <Button mnemonicParsing="false" onAction="#openUserDelete" text="Delete User" />
            <Button mnemonicParsing="false" onAction="#openUserEdit" text="Edit user" />
            <Button onAction="#openClientRegistration" text="Add client" />
            <Button onAction="#openVetRegistration" text="Add veterinarian" />
            <Button onAction="#openGroomerRegistration" text="Add groomer" />
        </children>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
    </HBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="userIdColumn" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="userNameColumn" prefWidth="160.0" text="Name" />
            <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Username" />
            <TableColumn fx:id="userPhoneColumn" prefWidth="140" text="Phone" />
            <TableColumn fx:id="userRoleColumn" prefWidth="120" text="Role" />
            <TableColumn fx:id="userIsBlockedColumn" prefWidth="120" text="Status" />
        </columns>
    </TableView>
</VBox>
