<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<TabPane prefHeight="540" prefWidth="1020" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainForm">
    <tabs>
        <Tab text="Users">
            <content>
                <fx:include fx:id="users" source="users-tab.fxml"/>
            </content>
        </Tab>

        <Tab text="Pets">
            <content>
                <fx:include fx:id="pets" source="pets-tab.fxml"/>
            </content>
        </Tab>

        <Tab text="Registrations">
            <content>
                <fx:include fx:id="registrations" source="registrations-tab.fxml"/>
            </content>
        </Tab>

        <Tab text="Incidents">
            <content>
                <fx:include fx:id="incidents" source="incidents-tab.fxml"/>
            </content>
        </Tab>
    </tabs>
</TabPane>
